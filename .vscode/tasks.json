{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "docker-build",
            "type": "docker-build",
            "platform": "python",
            "group": "build",
            "dockerBuild": {
                "dockerfile": "${workspaceFolder}/Dockerfile",
                "context": "${workspaceFolder}",
                "tag": "spacefunk-py:latest",
                "buildArgs": {
                    "BUILDKIT_INLINE_CACHE": "1",
                    "USER_ID": "1000",
                    "GROUP_ID": "1000"
                }
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "docker-run",
            "type": "docker-run",
            "dependsOn": ["docker-build"],
            "platform": "python",
            "python": {
                "file": "/spacefunk/bot.py",
            },
            "dockerRun": {
                "image": "spacefunk-py:latest",
                "envFiles": ["${workspaceFolder}/.env"]
            }
        }
    ],
}