{
    "configurations": [
        {
        "name": "Python: Current File",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/bot.py",
        "console": "integratedTerminal",
        "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Python: Bot Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/bot.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Docker: Bot Debug",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-run",
            "python": {
                "projectType": "general",
                "pathMappings": [
                    {
                        "localRoot": "${workspaceFolder}",
                        "remoteRoot": "/spacefunk"
                    }
                ],
            }
        },
    ]
}